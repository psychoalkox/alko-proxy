+std::string tls_file(const char* filename)
+{
+    const auto* directory = std::getenv("ALKO_TLS_DIR");
+    return (std::filesystem::path{ directory && *directory ? directory : "./resources" } / filename).string();
+}
+
+constexpr auto bootstrap_path = "/growtopia/server_data.php";
+
+// Rewrite only the endpoint fields, retaining metadata, line endings and
+// terminators supplied by the upstream server.
+bool rewrite_endpoint(std::string& body, std::string& address, uint16_t& port, int local_port)
+{
+    std::string rewritten;
+    bool have_port = false;
+    for (size_t start = 0; start < body.size();) {
+        const auto newline = body.find('\n', start);
+        const auto end = newline == std::string::npos ? body.size() : newline;
+        const auto value_end = end > start && body[end - 1] == '\r' ? end - 1 : end;
+        const std::string_view line{ body.data() + start, value_end - start };
+        if (line.starts_with("server|")) {
+            if (!address.empty() || line.size() == 7) return false;
+            address = line.substr(7);
+            if (address.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-") != std::string::npos) {
+                return false;
+            }
+            rewritten += "server|127.0.0.1";
+        } else if (line.starts_with("port|")) {
+            if (have_port) return false;
+            const auto field = line.substr(5);
+            const auto [last, ec] = std::from_chars(field.data(), field.data() + field.size(), port);
+            if (ec != std::errc{} || last != field.data() + field.size() || port == 0) return false;
+            have_port = true;
+            rewritten += "port|" + std::to_string(local_port);
+        } else {
+            rewritten += line;
+        }
+        start = newline == std::string::npos ? end : end + 1;
+        rewritten.append(body, value_end, start - value_end);
+    }
+    if (address.empty() || !have_port) return false;
+    body = std::move(rewritten);
+    return true;
+}
+}
